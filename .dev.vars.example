# Get a free key from https://ocr.space/ocrapi
OCR_SPACE_API_KEY=replace_with_your_free_api_key

# Optional. Recommended when this POC is deployed publicly.
# The browser sends this value in X-POC-Access-Token for OCR and confirmation requests.
OCR_POC_ACCESS_TOKEN=replace_with_a_long_random_test_token

# Optional overrides
# OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
# OCR_MAX_FILE_BYTES=1048576
# OCR_TIMEOUT_MS=60000
